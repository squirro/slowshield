# Local development only (`uv run slowshield serve` loads .env via python-dotenv).
SLOWSHIELD_CONFIG=config.toml
SLOWSHIELD_DATA_DIR=./data
SLOWSHIELD_PUBLIC_URL=http://localhost:8080
SLOWSHIELD_LOG_FORMAT=text
# GitHub Advisory feed (optional; without it the feed stays off and the UI shows how to enable it)
GITHUB_TOKEN=
# OpenTelemetry (optional) — e.g. a local Alloy: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
