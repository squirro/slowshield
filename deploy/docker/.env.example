# Copy to .env next to compose.yaml and adjust. Every value has a safe default.

# Images (Harbor while the project is private).
SLOWSHIELD_IMAGE=ghcr.io/squirro/slowshield:latest
SLOWSHIELD_CADDY_IMAGE=ghcr.io/squirro/slowshield-caddy:latest

# Hostnames Caddy serves (space separated). With per-ecosystem hostnames also set
# SLOWSHIELD_PYPI_HOSTNAMES / SLOWSHIELD_NPM_HOSTNAMES in config.toml (upstreams.*.hostnames).
SLOWSHIELD_HOSTNAMES=localhost
# Externally visible base URL (used for client setup snippets and npm tarball URLs).
SLOWSHIELD_PUBLIC_URL=https://localhost
# Also serve http://localhost (and 127.0.0.1, [::1]) over plain HTTP, so clients on this machine work without
# trusting Caddy's internal CA. Other hostnames are always redirected to HTTPS. Set to off on a shared server.
SLOWSHIELD_LOCAL_HTTP=on

# TLS: internal (Caddy's own CA) | acme (Let's Encrypt or any ACME CA) | files (your own cert)
SLOWSHIELD_TLS_MODE=internal
# acme
ACME_EMAIL=
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# files: PEM files inside TLS_CERT_DIR (mounted read-only at /certs)
TLS_CERT_DIR=./certs
TLS_CERT_NAME=tls.crt
TLS_KEY_NAME=tls.key
# 1.3 (default) or 1.2 for legacy clients (AEAD-only ECDHE suites are still enforced)
TLS_MIN_VERSION=1.3
# HSTS; append "; preload" only if you really want browser preload lists.
SLOWSHIELD_HSTS=max-age=63072000; includeSubDomains

# Published ports (rootless Docker: use >1024, e.g. 8080/8443, or allow unprivileged ports).
HTTP_PORT=80
HTTPS_PORT=443

# GitHub Advisory feed: path to a file holding the token (see secrets/README.md).
# Leave unset to run without it; the UI and the slowshield_feed_enabled metric will tell you.
#GITHUB_TOKEN_SECRET_FILE=./secrets/github_token

# Resources
SLOWSHIELD_WORKERS=2
SLOWSHIELD_CPUS=2
SLOWSHIELD_MEMORY=1g
CADDY_CPUS=1
CADDY_MEMORY=256m

# Caddy observability hooks (enabled automatically by compose.observability.yaml)
CADDY_METRICS=off
CADDY_TRACING=off
CADDY_ACCESS_LOG_FILE=off
