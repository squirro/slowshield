# ~/.config/slowshield/slowshield.env — read by both containers of the SlowShield pod.
SLOWSHIELD_HOSTNAMES=slowshield.example.com
SLOWSHIELD_PUBLIC_URL=https://slowshield.example.com:8443
# Published HTTPS port as seen by clients (8443 unless low ports are allowed, see slowshield.pod).
SLOWSHIELD_PUBLIC_HTTPS_PORT=8443

# TLS: internal | acme | files
SLOWSHIELD_TLS_MODE=internal
ACME_EMAIL=
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TLS_CERT_FILE=/certs/tls.crt
TLS_KEY_FILE=/certs/tls.key
TLS_MIN_VERSION=1.3

SLOWSHIELD_WORKERS=2
SLOWSHIELD_LOG_LEVEL=info

# UI sign-in with a password: slowshield.container.d/password.conf.example (the hash never goes in this file, which
# the Caddy container reads too).

# UI sign-in with OIDC (docs/authentication.md); the client key comes from slowshield.container.d/oidc-client.conf.
# SLOWSHIELD_AUTH=oidc
# SLOWSHIELD_UI_REQUIRE_LOGIN=true
# SLOWSHIELD_UI_URLS=https://slowshield.example.com:8443
# SLOWSHIELD_OIDC_ISSUER=https://idp.example.com/realms/example
# SLOWSHIELD_OIDC_CLIENT_ID=slowshield
# SLOWSHIELD_OIDC_ROLES_CLAIM=slowshield_roles
# SLOWSHIELD_OIDC_ADMIN_VALUES=SlowShield Admins
# SLOWSHIELD_OIDC_USER_VALUES=SlowShield Users
