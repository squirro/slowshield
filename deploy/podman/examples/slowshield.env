# ~/.config/slowshield/slowshield.env — read by both containers of the SlowShield pod.
SLOWSHIELD_HOSTNAMES=slowshield.example.com
SLOWSHIELD_PUBLIC_URL=https://slowshield.example.com:8443
# Published HTTPS port as seen by clients (8443 unless low ports are allowed, see slowshield.pod).
SLOWSHIELD_PUBLIC_HTTPS_PORT=8443

# TLS: internal | acme | files
SLOWSHIELD_TLS_MODE=internal
ACME_EMAIL=
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TLS_CERT_FILE=/certs/tls.crt
TLS_KEY_FILE=/certs/tls.key
TLS_MIN_VERSION=1.3

SLOWSHIELD_WORKERS=2
SLOWSHIELD_LOG_LEVEL=info
