# Grafana Alloy: receives OTLP from SlowShield and Caddy, scrapes Caddy metrics, tails Caddy access
# logs, and forwards everything to Prometheus, Loki and Tempo.
[Unit]
Description=SlowShield observability: Grafana Alloy

[Container]
# Pinned by digest (observability/images.env); bump in the repo instead of podman auto-update.
ContainerName=slowshield-alloy
Image=docker.io/grafana/alloy:v1.20.1@sha256:2aa2099af76c0098d4af7a4d6e48f86cb66dc1a000222ad927a1c67c6542d13f
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
UserNS=keep-id:uid=473,gid=473
User=473
Group=473
Network=slowshield-telemetry.network
NetworkAlias=alloy
PidsLimit=512
Ulimit=nofile=65536:65536
Volume=slowshield-alloy-data.volume:/var/lib/alloy/data
Volume=%h/.config/slowshield/observability/alloy/config.alloy:/etc/alloy/config.alloy:ro,Z
# Caddy writes its JSON access log here (same host user via keep-id, so the 0600/0640 file is readable).
Volume=slowshield-caddy-logs.volume:/var/log/caddy:ro
# In a Podman pod every container answers to the pod name on the network.
Environment=CADDY_METRICS_TARGET=slowshield:9180
Exec=run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data --server.http.listen-addr=0.0.0.0:12345 --disable-reporting
PodmanArgs=--memory=512m --cpus=1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
