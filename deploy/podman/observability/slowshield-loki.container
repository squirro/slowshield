# Loki (single binary, filesystem storage, OTLP ingestion).
[Unit]
Description=SlowShield observability: Loki

[Container]
# Pinned by digest (observability/images.env); bump in the repo instead of podman auto-update.
ContainerName=slowshield-loki
Image=docker.io/grafana/loki:3.7.9@sha256:0db216b630ae1f348a1584c67f3cead8b4c1fc839169a39501db664744158e28
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
UserNS=keep-id:uid=10001,gid=10001
User=10001
Group=10001
Network=slowshield-telemetry.network
NetworkAlias=loki
PidsLimit=512
Ulimit=nofile=65536:65536
Volume=slowshield-loki-data.volume:/loki
Volume=%h/.config/slowshield/observability/loki/loki.yaml:/etc/loki/loki.yaml:ro,Z
Exec=-config.file=/etc/loki/loki.yaml
PodmanArgs=--memory=1g --cpus=1

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
