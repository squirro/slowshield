# UI sign-in with a password (docs/authentication.md#password-sign-in): one Admin, the UI read-only for everyone
# else. The hash is a Podman secret mounted into this container only: slowshield.env is also read by the Caddy
# container, which must never see it. Make the hash and store it (once):
#   podman run --rm -it ghcr.io/squirro/slowshield auth hash-password | podman secret create slowshield_password_hash -
# then copy this file to slowshield.container.d/password.conf, set the username below, and run
#   systemctl --user daemon-reload && systemctl --user restart slowshield-pod
[Container]
Secret=slowshield_password_hash,type=mount,target=/run/secrets/password_hash,uid=65532,gid=65532,mode=0400
Environment=SLOWSHIELD_AUTH=password
Environment=SLOWSHIELD_AUTH_USERNAME=admin
Environment=SLOWSHIELD_AUTH_PASSWORD_HASH_FILE=/run/secrets/password_hash
