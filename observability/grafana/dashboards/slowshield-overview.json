          "expr": "sum(rate(slowshield_decisions_total{instance=~\"$instance\",slowshield_ecosystem=~\"$ecosystem\",slowshield_kind=\"artifact\",slowshield_decision=\"served\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "__auto"
