        "hide": 2,
        "current": {
          "text": "slowshield-tempo",
          "value": "slowshield-tempo"
        },
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(slowshield_build_info, instance)",
          "refId": "vars",
          "qryType": 1
        },
        "definition": "label_values(slowshield_build_info, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "ecosystem",
        "label": "Ecosystem",
        "type": "custom",
        "query": "pypi,npm,go,maven,cargo",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "pypi",
