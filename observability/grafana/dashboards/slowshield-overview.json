    {
      "type": "timeseries",
      "title": "Policy decisions",
      "description": "Every metadata and artifact request ends in one decision.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
