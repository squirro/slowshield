          "expr": "histogram_quantile(0.99, sum (rate(http_server_request_duration_seconds{instance=~\"$instance\",http_route=~\".*simple/\\\\{project\\\\}/|(/npm)?/\\\\{package\\\\}\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
