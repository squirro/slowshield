        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum (histogram_count(rate(http_server_request_duration_seconds{instance=~\"$instance\",http_response_status_code=~\"5..\"}[$__rate_interval]))) / sum (histogram_count(rate(http_server_request_duration_seconds{instance=~\"$instance\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2fa866",
                "value": null
              },
              {
                "color": "#8b72f0",
                "value": 0.01
              },
              {
                "color": "#e0344c",
                "value": 0.05
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
