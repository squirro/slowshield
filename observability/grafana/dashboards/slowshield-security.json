    {
      "type": "table",
      "title": "Top blocked packages",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(15, sum by (slowshield_ecosystem, slowshield_package, slowshield_version) (count_over_time({service_name=\"slowshield\"} | slowshield_event=~\"blocked\" [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "count",
              "slowshield_ecosystem": "ecosystem",
              "slowshield_package": "package",
              "slowshield_version": "version"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
