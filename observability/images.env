# Official upstream images for the observability stack, pinned by multi-arch manifest-list digest.
# Single source of truth: compose, Quadlet and Helm reference these exact strings
# (`python observability/check.py` fails if any copy drifts). Dependabot bumps the compose file;
# `uv run python observability/sync.py --from-compose` adopts that here and re-syncs the rest.
ALLOY_IMAGE=docker.io/grafana/alloy:v1.21.2@sha256:89a5a320168387336b9ac3c850609c3ba7757eadd4ae5f1d819deb35e9854b18
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2
LOKI_IMAGE=docker.io/grafana/loki:3.7.9@sha256:0db216b630ae1f348a1584c67f3cead8b4c1fc839169a39501db664744158e28
TEMPO_IMAGE=docker.io/grafana/tempo:3.1.1@sha256:64e2fbd56d9c2b3412a4b430a58ea59e91a670b1e75f920a0c702213ad145044
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f
