# Official upstream images for the observability stack, pinned by multi-arch manifest-list digest.
# Single source of truth: compose, Quadlet and Helm reference these exact strings
# (`python observability/check.py` fails if any copy drifts). Dependabot bumps the compose file;
# `uv run python observability/sync.py --from-compose` adopts that here and re-syncs the rest.
ALLOY_IMAGE=docker.io/grafana/alloy:v1.20.1@sha256:2aa2099af76c0098d4af7a4d6e48f86cb66dc1a000222ad927a1c67c6542d13f
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
LOKI_IMAGE=docker.io/grafana/loki:3.7.8@sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193
TEMPO_IMAGE=docker.io/grafana/tempo:3.1.0@sha256:3076b8dcdfb32fd6bc5ccef85e7b7313e6199b9cb84366257fc17ecb696db5fd
GRAFANA_IMAGE=docker.io/grafana/grafana:13.2.3@sha256:b28bae15e219c998fb0e0424ed724930cc61b1f61fb404d47c862f9a23f9e572
