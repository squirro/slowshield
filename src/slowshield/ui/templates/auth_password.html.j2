{% extends "base.html.j2" %}
{% block content %}
<div class="page-head"><div><h1>Sign in</h1>
  <p class="muted">Sign in as this SlowShield's administrator. Without signing in, the UI is read-only.</p></div></div>
<section class="card narrow">
  {% if error %}<p class="error-text" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/ui/auth/login" class="stack">
    <input type="hidden" name="next" value="{{ next }}">
    <label for="username">Username</label>
    <input id="username" name="username" type="text" autocomplete="username" required autofocus>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <div class="actions"><button type="submit" class="button primary">Sign in</button></div>
  </form>
</section>
{% endblock %}
