{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}Overview{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Overview</h1>
    <p class="muted">New releases are held back for <strong>{{ cfg.default_delay_days|round(1)|replace(".0", "") }} days</strong>
      before SlowShield serves them{% if cfg.exceptions %}, with {{ cfg.exceptions|length }} package exception{{ "s" if cfg.exceptions|length != 1 }}{% endif %}.</p>
  </div>
  <div class="controls">
    {% if choices %}<form action="/ui/" method="get">{% if eco %}<input type="hidden" name="eco" value="{{ eco }}">{% endif %}
      <input type="hidden" name="range" value="{{ w.key }}">{{ m.scope_select(scope, choices) }}<noscript><button type="submit" class="button">Show</button></noscript></form>{% endif %}
    {{ m.eco_filter(eco, "/ui/", {"range": w.key, "in": scope}) }}
    {{ m.range_picker(w.key, "/ui/", {"eco": eco, "in": scope}) }}
  </div>
</div>
{% include "partials/dashboard_body.html.j2" %}
{% endblock %}
