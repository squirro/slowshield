{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}Security{% endblock %}
{% block content %}
<div class="page-head">
  <div><h1>Security timeline</h1><p class="muted">Blocked malware, tamper detections, fail-open serves and downloads refused for being too new.</p></div>
  <div class="controls">{{ m.range_picker(range, "/ui/security", {"type": type, "eco": eco, "q": q, "ip": ip}) }}
    <a class="button" href="/ui/security.csv?range={{ range }}">Export CSV</a></div>
</div>
<div class="chips" role="group" aria-label="Event type">
  <a href="/ui/security{{ qs({'range': range, 'eco': eco, 'q': q, 'ip': ip}) }}"{% if not type %} aria-current="true"{% endif %}>All <b>{{ counts.values()|sum }}</b></a>
  {% for t, label in event_label.items() %}
  <a class="chip-{{ t }}" href="/ui/security{{ qs({'range': range, 'eco': eco, 'q': q, 'ip': ip, 'type': t}) }}"{% if type == t %} aria-current="true"{% endif %}>{{ label }} <b>{{ counts.get(t, 0) }}</b></a>
  {% endfor %}
</div>
<form class="filters" action="/ui/security" method="get" role="search"
      hx-get="/ui/partials/security" hx-target="#security-region" hx-swap="outerHTML" hx-trigger="input changed delay:250ms, change">
  <input type="hidden" name="range" value="{{ range }}">
  {% if type %}<input type="hidden" name="type" value="{{ type }}">{% endif %}
  <label class="search"><span class="sr-only">Package</span><input type="search" name="q" value="{{ q }}" placeholder="Package…" autocomplete="off"></label>
  <label class="search"><span class="sr-only">Client IP</span><input type="search" name="ip" value="{{ ip }}" placeholder="Client IP…" autocomplete="off"></label>
  <label><span class="sr-only">Ecosystem</span><select name="eco"><option value="">All ecosystems</option>
    <option value="pypi"{% if eco == "pypi" %} selected{% endif %}>PyPI</option><option value="npm"{% if eco == "npm" %} selected{% endif %}>npm</option></select></label>
  <noscript><button type="submit">Apply</button></noscript>
</form>
{% include "partials/security_table.html.j2" %}
{% endblock %}
