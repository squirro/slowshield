{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}Setup{% endblock %}
{% macro snippet(code, label="", age="") -%}
<div class="snippet"{% if age %} data-age="{{ age }}"{% if age == "off" %} hidden{% endif %}{% endif %}>
{%- if label %}<span class="snippet-label">{{ label }}</span>{% endif %}
<pre><code>{{ code }}</code></pre><button type="button" class="copy" data-copy>Copy</button></div>
{%- endmacro %}
{#- `code` with the package managers' own release age, and `plain` without; the switch shows one of them. -#}
{% macro aged(code, plain, label="") -%}
{%- if code == plain %}{{ snippet(code, label) }}{% else %}{{ snippet(code, label, "on") }}{{ snippet(plain, label, "off") }}{% endif -%}
{%- endmacro %}
{% set days = cfg.default_delay_days|round(1)|replace(".0", "") %}
{% block content %}
<div class="page-head">
  <div><h1>Client setup</h1><p class="muted">Point pip, uv, npm, go, Maven, Gradle, Cargo, NuGet, Composer, Bundler, gem and container runtimes at SlowShield. New releases become installable {{ days }} days after publication.</p></div>
</div>
{% if also_at %}
<section class="card" role="note">
  <p><strong>New clients use <code>{{ setup_url }}</code>.</strong> Clients set up with
    <code>{{ also_at }}</code> keep working: this instance still answers there, and the package URLs it hands out
    stay there too.</p>
</section>
{% endif %}
{% if legacy_hosts %}
<section class="card" role="note">
  <p><strong>Per-ecosystem hostnames are deprecated</strong> and stop working in SlowShield 0.1:
    {% for h in legacy_hosts %}<code>{{ h }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.
    Point clients at the URLs below and re-lock (or replace the hostname in lockfiles), so nothing depends on
    them any more.</p>
</section>
{% endif %}
{% if secure %}
<section class="card">
  <p><strong>Plain HTTP on localhost.</strong> These URLs work without trusting a certificate; traffic stays on this
    machine. HTTPS works too once your clients trust Caddy's root CA: <code>{{ secure.pypi }}</code>,
    <code>{{ secure.npm }}</code>, <code>{{ secure.go }}</code>, <code>{{ secure.maven }}</code>,
    <code>{{ secure.cargo }}</code>, <code>{{ secure.nuget }}</code>, <code>{{ secure.composer }}</code> and
    <code>{{ secure.rubygems }}</code>.</p>
</section>
{% endif %}
{% if age_days %}
<section class="card age-layer">
  <label class="age-switch"><input type="checkbox" data-age-toggle checked disabled>
    <span><strong>Two layers:</strong> package managers also wait {{ age_days }} days on their own</span></label>
  <p class="muted small">SlowShield holds new releases for {{ days }} days. With this on, the snippets below also set the
    release age of every package manager that has one, to {{ age_days }} days. Normally that never triggers, because
    SlowShield is stricter. But a release still waits if a machine or build goes around SlowShield, or if SlowShield
    serves a brand-new package because none of its versions is old enough yet. Per tool shows the version each package
    manager needs.</p>
</section>
{% endif %}
<ol class="setup-steps">
  <li class="card">
    <header class="card-head"><h2><span class="step">1</span> Use it for everything</h2></header>
    <p class="muted">Environment variables in your shell profile: pip, uv, npm and go then use SlowShield in every new
      terminal{% if age_days %}<span data-age="on">, and pip and npm also wait {{ age_days }} days themselves
      (pip 26.1 and npm 11.10 or later; pip 26.0 refuses to run with it). For uv, set it in each project's
      <code>pyproject.toml</code> (Per tool)</span>{% endif %}. Remove the lines to switch it off.</p>
    <div class="tabs" data-tabs="shell">
      <div class="tablist" role="tablist" aria-label="Shell">
        {%- for sh in snippets.shells %}
        <button type="button" role="tab" id="t-sh-{{ sh.id }}" aria-controls="sh-{{ sh.id }}" data-shell="{{ sh.id }}"
          aria-selected="{{ 'true' if sh.id == shell else 'false' }}"{% if sh.id != shell %} tabindex="-1"{% endif %}>{{ sh.label }}</button>
        {%- endfor %}
      </div>
      {%- for sh in snippets.shells %}
      <div role="tabpanel" id="sh-{{ sh.id }}" aria-labelledby="t-sh-{{ sh.id }}"{% if sh.id != shell %} hidden{% endif %}>
        {{- aged(sh.code, sh.plain) -}}
      </div>
      {%- endfor %}
    </div>
    {% if os == "windows" %}<p class="muted small">On Windows, set these variables under
      <em>System → Environment Variables</em>, or use the bash tab in WSL.</p>{% endif %}
  </li>
  <li class="card">
    <header class="card-head"><h2><span class="step">2</span> Try it</h2></header>
    {{ snippet(snippets.try_python) }}
    <p class="muted small">A throwaway virtualenv, because Homebrew and current Linux Pythons refuse pip installs outside
      one. Releases younger than {{ days }} days are held back; known malware is refused with HTTP 451.</p>
  </li>
</ol>
<section class="card tool-finder" data-tool-finder>
  <header class="card-head"><h2>Per tool</h2><a href="{{ docs_home }}" rel="noopener noreferrer" target="_blank">Guides for every ecosystem ↗</a></header>
  <p class="muted">For a single tool or project instead. Index URL <code>{{ pypi_index }}</code>, registry URL
    <code>{{ npm_registry }}</code>, Go module proxy <code>{{ go_proxy }}</code>, Maven repository
    <code>{{ maven_repo }}</code>, Cargo index <code>sparse+{{ cargo_index }}</code>, NuGet source
    <code>{{ nuget_source }}</code>, Composer repository <code>{{ composer_repo }}</code>, RubyGems mirror
    <code>{{ rubygems_mirror }}</code>.</p>
  <label class="tool-search"><span>Find your tool</span>
    <input type="search" list="tool-names" placeholder="e.g. poetry, yarn, pnpm" autocomplete="off" spellcheck="false"
      data-tool-input></label>
  <datalist id="tool-names">{% for t in tools %}<option value="{{ t.name }}"></option>{% endfor %}</datalist>
  <div class="tool-picks" data-tool-hint>
    {%- for e in ecosystems.values() %}
    <div class="tool-group"><span class="tool-group-label">{{ e.label }}</span>
      {%- for t in tools if t.ecosystem == e.id %}<button type="button" class="tool-pick" data-tool-pick="{{ t.name }}">{{ t.name }}</button>{% endfor -%}
    </div>
    {%- endfor %}
  </div>
  <p class="muted small" role="status" data-tool-empty hidden>No tool matches. Try pip, uv, Poetry, PDM, Pipenv, npm,
    pnpm, Yarn, Bun, Go, Maven, Gradle, sbt, Coursier, Cargo, NuGet, Composer, Bundler, gem, containerd, Docker, Podman
    or BuildKit.</p>
  <div class="tool-results">
    {%- for t in tools %}
    {%- set plain = tools_plain[loop.index0] %}
    <div class="tool" data-tool="{{ (t.name ~ ' ' ~ t.keywords)|lower }}" data-tool-name="{{ t.name }}">
      <h3>{{ t.name }}{% if not enabled[t.ecosystem] %}
        <span class="badge">disabled</span>{% endif %}
        <a class="tool-guide" href="{{ docs(t.ecosystem, t.name) }}" rel="noopener noreferrer" target="_blank">Guide ↗</a></h3>
      {%- if t.age %}<p class="muted small age-note" data-age="on">Release age: {{ t.age }}</p>{% endif %}
      {%- if t.note %}<p class="muted small tool-note">{{ t.note|ticks }}</p>{% endif %}
      {%- if t.snippets == plain.snippets %}
      {%- for label, code in t.snippets %}{{ snippet(code, label) }}{% endfor %}
      {%- else %}
      <div data-age="on">{% for label, code in t.snippets %}{{ snippet(code, label) }}{% endfor %}</div>
      <div data-age="off" hidden>{% for label, code in plain.snippets %}{{ snippet(code, label) }}{% endfor %}</div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>
<section class="card">
  <header class="card-head"><h2>CI and containers</h2><a href="{{ docs_home }}container-builds/" rel="noopener noreferrer"
    target="_blank">Building container images through SlowShield ↗</a></header>
  <div class="grid-2">
    <div>{{ aged(ci, ci_plain, "CI") }}</div>
    <div>{{ aged(dockerfile, dockerfile_plain, "Dockerfile") }}</div>
  </div>
  <p class="muted small">Builds need a URL they can reach: inside a container, <code>localhost</code> is the container
    itself.</p>
  <h3 class="sub">Block these at the firewall so nothing goes around SlowShield</h3>
  <div class="grid-2 firewall">
    <div class="host-groups">
      {%- for e, hosts in firewall %}
      <div class="host-group">{{ m.eco(e) }}<span class="hosts">
        {%- for h in hosts %}<code class="host">{{ h }}</code>{% endfor -%}
      </span></div>
      {%- endfor %}
      <p class="muted small">The go command reaches the checksum database through SlowShield too. BuildKit and Docker's
        classic image store go to the registry themselves after a refusal.{% if firewall_off %} Not listed, because
        they are switched off here:
        {% for e in firewall_off %}{{ eco_label[e] }}{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>
    </div>
    <div>{{ snippet(firewall_text, "All hosts, one per line") }}</div>
  </div>
</section>
<section class="card expect">
  <header class="card-head"><h2>What to expect</h2></header>
  <div class="expect-facts">
    <div class="kpi hold"><div class="kpi-label">Too new</div><div class="fact-value">Hidden from indexes</div>
      <p class="muted small">A direct download gets <code>425</code> or <code>403</code>, with <code>Retry-After</code>.</p>
    </div>
    <div class="kpi danger"><div class="kpi-label">Malware</div><div class="fact-value">451</div>
      <p class="muted small">With the advisory in the body.</p></div>
    <div class="kpi tamper"><div class="kpi-label">Tampering</div><div class="fact-value">Download aborted</div>
      <p class="muted small">And recorded as a security event.</p></div>
    <div class="kpi fail-open"><div class="kpi-label">Brand-new packages</div><div class="fact-value">Served or held</div>
      <p class="muted small">When no version is old enough yet. Depends on the ecosystem.</p></div>
  </div>
  <div class="table-wrap">
    <table class="table expect-table">
      <thead><tr><th scope="col">Ecosystem</th><th scope="col">Too new in a range</th><th scope="col">Pinned too new</th>
        <th scope="col">Blocked</th><th scope="col">Brand-new</th><th scope="col">Good to know</th></tr></thead>
      <tbody>
        {%- for r in expect %}
        <tr{% if not r.enabled %} class="withdrawn"{% endif %}>
          <th scope="row">{{ m.eco(r.eco) }}{% if not r.enabled %} <span class="badge">disabled</span>{% endif %}</th>
          <td data-label="Too new in a range"><span>{{ r.in_range|ticks }}</span></td>
          <td data-label="Pinned too new"><span><span class="badge st-held">{{ r.pinned }}</span>
            {%- if r.pinned_how %} <span class="muted small">{{ r.pinned_how }}</span>{% endif %}</span></td>
          <td data-label="Blocked"><span><span class="badge st-blocked">{{ r.blocked }}</span>
            {%- if r.blocked_how %} <span class="muted small">{{ r.blocked_how }}</span>{% endif %}</span></td>
          <td data-label="Brand-new"><span>{% if r.fail_open %}<span class="badge ev-fail_open">served</span>
            <span class="muted small">{{ "first " ~ days ~ " days, fail-open" if r.eco == "oci" else "fail-open" }}</span>
            {%- else %}<span class="badge st-held">held</span>{% endif %}</span></td>
          <td data-label="Good to know" class="small">{% if r.note %}<span>{{ r.note|ticks }}</span>{% endif %}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- if age_days %}
  <p class="muted small expect-foot" data-age="on"><strong>Exceptions:</strong> a release an administrator lets
    through early still waits {{ age_days }} days in package managers with their own release age. Use their exclude
    list (<code>min-release-age-exclude</code> in npm, <code>exclude-newer-package</code> in uv,
    <code>solver.min-release-age-exclude</code> in Poetry), or switch the second layer off for that build.</p>
  {%- endif %}
</section>
{% endblock %}
