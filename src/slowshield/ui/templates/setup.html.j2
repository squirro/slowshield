{% extends "base.html.j2" %}
{% block title %}Setup{% endblock %}
{% macro snippet(code, label="") -%}
<div class="snippet">{% if label %}<span class="snippet-label">{{ label }}</span>{% endif %}
<pre><code>{{ code }}</code></pre><button type="button" class="copy" data-copy>Copy</button></div>
{%- endmacro %}
{% set days = cfg.default_delay_days|round(1)|replace(".0", "") %}
{% block content %}
<div class="page-head">
  <div><h1>Client setup</h1><p class="muted">Point pip, uv and npm at SlowShield. New releases become installable {{ days }} days after publication.</p></div>
</div>
{% if legacy_hosts %}
<section class="card" role="note">
  <p><strong>Per-ecosystem hostnames are deprecated</strong> and stop working in SlowShield 0.1:
    {% for h in legacy_hosts %}<code>{{ h }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.
    Point clients at the URLs below and re-lock (or replace the hostname in lockfiles), so nothing depends on
    them any more.</p>
</section>
{% endif %}
{% if secure %}
<section class="card">
  <p><strong>Plain HTTP on localhost.</strong> These URLs work without trusting a certificate; traffic stays on this
    machine. HTTPS works too once your clients trust Caddy's root CA: <code>{{ secure.pypi }}</code> and
    <code>{{ secure.npm }}</code>.</p>
</section>
{% endif %}
<ol class="setup-steps">
  <li class="card">
    <header class="card-head"><h2><span class="step">1</span> Use it for everything</h2></header>
    <p class="muted">Three environment variables in your shell profile: pip, uv and npm then go through SlowShield in
      every new terminal. Remove the lines to switch it off.</p>
    <div class="tabs" data-tabs="shell">
      <div class="tablist" role="tablist" aria-label="Shell">
        {%- for sh in snippets.shells %}
        <button type="button" role="tab" id="t-sh-{{ sh.id }}" aria-controls="sh-{{ sh.id }}" data-shell="{{ sh.id }}"
          aria-selected="{{ 'true' if sh.id == shell else 'false' }}"{% if sh.id != shell %} tabindex="-1"{% endif %}>{{ sh.label }}</button>
        {%- endfor %}
      </div>
      {%- for sh in snippets.shells %}
      <div class="snippet" role="tabpanel" id="sh-{{ sh.id }}" aria-labelledby="t-sh-{{ sh.id }}"{% if sh.id != shell %} hidden{% endif %}>
<pre><code>{{ sh.code }}</code></pre><button type="button" class="copy" data-copy>Copy</button></div>
      {%- endfor %}
    </div>
    {% if os == "windows" %}<p class="muted small">On Windows, set the three variables under
      <em>System → Environment Variables</em>, or use the bash tab in WSL.</p>{% endif %}
  </li>
  <li class="card">
    <header class="card-head"><h2><span class="step">2</span> Try it</h2></header>
    {{ snippet(snippets.try_python) }}
    <p class="muted small">A throwaway virtualenv, because Homebrew and current Linux Pythons refuse pip installs outside
      one. Releases younger than {{ days }} days are held back; known malware is refused with HTTP 451.</p>
  </li>
</ol>
<section class="card tool-finder" data-tool-finder>
  <header class="card-head"><h2>Per tool</h2></header>
  <p class="muted">For a single tool or project instead. Index URL <code>{{ pypi_index }}</code>, registry URL
    <code>{{ npm_registry }}</code>.</p>
  <label class="tool-search"><span>Find your tool</span>
    <input type="search" list="tool-names" placeholder="e.g. poetry, yarn, pnpm" autocomplete="off" spellcheck="false"
      data-tool-input></label>
  <datalist id="tool-names">{% for t in tools %}<option value="{{ t.name }}"></option>{% endfor %}</datalist>
  <p class="tool-picks" data-tool-hint>
    {%- for t in tools %}<button type="button" class="tool-pick" data-tool-pick="{{ t.name }}">{{ t.name }}</button>{% endfor -%}
  </p>
  <p class="muted small" role="status" data-tool-empty hidden>No tool matches. Try pip, uv, Poetry, PDM, Pipenv, npm,
    pnpm, Yarn or Bun.</p>
  <div class="tool-results">
    {%- for t in tools %}
    <div class="tool" data-tool="{{ (t.name ~ ' ' ~ t.keywords)|lower }}">
      <h3>{{ t.name }}{% if (t.ecosystem == "pypi" and not pypi_enabled) or (t.ecosystem == "npm" and not npm_enabled) %}
        <span class="badge">disabled</span>{% endif %}</h3>
      {%- for label, code in t.snippets %}{{ snippet(code, label) }}{% endfor %}
    </div>
    {%- endfor %}
  </div>
</section>
<section class="card">
  <header class="card-head"><h2>CI and containers</h2></header>
  <div class="grid-2">
    {{ snippet("# GitHub Actions (workflow or job)\nenv:\n  PIP_INDEX_URL: " ~ pypi_index ~ "\n  UV_DEFAULT_INDEX: " ~ pypi_index ~ "\n  npm_config_registry: " ~ npm_registry, "CI") }}
    {{ snippet("ENV PIP_INDEX_URL=" ~ pypi_index ~ " \\\n    UV_DEFAULT_INDEX=" ~ pypi_index ~ " \\\n    npm_config_registry=" ~ npm_registry, "Dockerfile") }}
  </div>
  <p class="muted small">Builds and runners need a URL they can reach: inside a container, <code>localhost</code> is
    the container itself. Block direct access to pypi.org and registry.npmjs.org at the firewall so nothing
    bypasses SlowShield.</p>
</section>
<section class="card">
  <header class="card-head"><h2>What to expect</h2></header>
  <ul>
    <li><strong>Too new:</strong> versions younger than the delay are hidden from indexes; downloading one directly (e.g. from a lockfile) returns <code>403</code> with a <code>Retry-After</code> header.</li>
    <li><strong>Malware:</strong> packages or versions on the blocklist return <code>451 Unavailable For Legal Reasons</code> with the advisory in the body.</li>
    <li><strong>Brand-new packages:</strong> if <em>no</em> version is old enough yet, SlowShield fails open and serves them, recording a fail-open event.</li>
    <li><strong>Tampering:</strong> every artifact is fingerprinted on first download; if the bytes ever change, the download is aborted and the event recorded.</li>
  </ul>
</section>
{% endblock %}
